#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# svc-avahi (longrun) - mDNS/DNS-SD responder for AirPrint, on the private bus from svc-dbus.
#
# Configuration (/etc/avahi/avahi-daemon.conf) is generated by init-cups-config. avahi-daemon stays
# in the foreground (no -D) under s6, and keeps its defaults: it drops root to the avahi user and
# chroots itself, which needs no capability beyond Docker's default set.
#
# If dbus-daemon restarts, avahi-daemon exits too ("Disconnected from D-Bus") and s6 restarts it;
# until the bus is back each attempt fails fast and s6 retries once a second.
#
# With CUPS_AIRPRINT=false (the default) this service idles, like svc-dbus.

unset CUPS_ADMIN_PASSWORD FILE__CUPS_ADMIN_PASSWORD

airprint="$(/usr/local/bin/cups-env-bool CUPS_AIRPRINT false 2>/dev/null)" || airprint=false
if [[ "${airprint}" != true ]]; then
    exec sleep infinity
fi

# Stale from the previous run (s6-overlay does not clear /run on `docker restart`): with it,
# avahi-daemon refuses to start ("Daemon already running on PID ...").
rm -f /run/avahi-daemon/pid

exec avahi-daemon --no-proc-title
